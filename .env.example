# Copy to .env.local and fill in. Never commit real keys.

# Supabase — use the DEV project for local work (never point local at prod).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: support chatbot LLM fallback. Scripted flows work without it.
ANTHROPIC_API_KEY=

# Optional: set to "true" once the accessibility statement wording is approved.
NEXT_PUBLIC_A11Y_APPROVED=
